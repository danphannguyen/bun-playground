# ===========================================
# Root Environment Configuration
# Single source of truth for all services
# ===========================================
# Copy this file to .env: cp .env.example .env

# General
NODE_ENV=development

# ===========================================
# Backend Configuration (NestJS - Port 3001)
# ===========================================
PORT=3001
BACKEND_PORT=3001
CORS_ORIGIN=http://localhost:3000
BACKEND_CORS_ORIGIN=http://localhost:3000
API_PREFIX=api
BACKEND_API_PREFIX=api

# ===========================================
# Frontend Configuration (Next.js - Port 3000)
# ===========================================
FRONTEND_PORT=3000

# Public variables (exposed to browser)
# For Docker: use http://backend:3001
# For local dev: use http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Bun Playground
NEXT_PUBLIC_APP_VERSION=0.1.0

# ===========================================
# Docker Compose Resource Limits
# ===========================================
BACKEND_MEMORY_LIMIT=512M
BACKEND_MEMORY_RESERVATION=256M
FRONTEND_MEMORY_LIMIT=1G
FRONTEND_MEMORY_RESERVATION=512M
